{%- stylesheet -%}
  .my-block {
    display: flex;
    flex-direction: column;
    gap: var(--my-gap, 8px);
    padding: var(--my-padding, 16px);
    border-radius: var(--my-radius, 8px);
  }

  .my-block__media {
    position: relative;
    width: 100%;
  }

  .my-block__info {
    display: flex;
    flex-direction: column;
    gap: var(--my-gap, 8px);
    margin-top: auto;
  }

  @media screen and (max-width: 1023px) {
    .my-block--layout-horizontal {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (min-width: 1024px) {
    .my-block--layout-horizontal {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
{%- endstylesheet -%}
